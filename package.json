{
  "name": "web-urbanoa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "i18n:check": "npm run i18n:audit",
    "i18n:audit": "node scripts/i18n-excel.mjs audit --config i18n-excel.config.json --excel docs/traducciones_agrupadas_urbanoa.xlsx",
    "i18n:sync": "node scripts/i18n-excel.mjs sync --config i18n-excel.config.json",
    "i18n:prune": "node scripts/i18n-excel.mjs prune --config i18n-excel.config.json",
    "i18n:excel": "node scripts/i18n-excel.mjs export --config i18n-excel.config.json",
    "i18n:import": "node scripts/i18n-excel.mjs import --config i18n-excel.config.json",
    "i18n:test": "node scripts/i18n-excel.roundtrip.test.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss,json}\"",
    "check": "npm run i18n:check && npm run lint && npm run format:check && npm run build"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@lucide/angular": "^1.23.0",
    "leaflet": "^1.9.4",
    "lottie-web": "^5.13.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.3",
    "@angular/cli": "^20.0.3",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/leaflet": "^1.9.20",
    "angular-eslint": "21.0.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "exceljs": "^4.4.0",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.9.4",
    "typescript": "~5.8.2",
    "typescript-eslint": "8.46.4"
  }
}

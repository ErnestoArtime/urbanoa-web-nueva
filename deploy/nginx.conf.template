# Cache only successful responses for files whose names change with the build.
# HTML and missing chunks must never be reused across deployments.
map "$status:$uri" $urbanoa_cache_control {
  default "no-store";
  "~*^(200|304):/.*-[a-z0-9]{8,}\.(js|css)$" "public, max-age=31536000, immutable";
  ~*^(200|304):/assets/(municipios|brand)/.*\.(png|jpg|jpeg|webp|svg|json)$ "public, max-age=86400, stale-while-revalidate=604800";
  ~*^(200|304):/.*\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|json|woff|woff2)$ "no-cache";
}

server {
  listen       10213;
  server_name  _;
  root         /usr/share/nginx/html;
  index        index.html;
  gzip on;
  gzip_vary on;
  gzip_comp_level 6;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain;
  client_max_body_size 20M;
  resolver_timeout 5s;

  client_body_timeout 30s;
  client_header_timeout 30s;
  send_timeout 30s;
  keepalive_timeout 65;
  keepalive_requests 100;

  add_header Access-Control-Allow-Origin * always;
  add_header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload";
  add_header X-Frame-Options DENY;
  add_header X-Content-Type-Options nosniff;
  add_header X-XSS-Protection "1; mode=block";
  add_header Cache-Control $urbanoa_cache_control always;

  location = /healthz {
    return 200 'ok';
    add_header Content-Type text/plain;
  }

  location /external-content/ {
    proxy_pass https://arinpark.eus/;
    proxy_set_header Host arinpark.eus;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /ops-api/ {
    rewrite ^/ops-api/OPSWebServices(?:Legacy)?API/(.*)$ /OPSWebServicesUrbAPI/$1 break;
    rewrite ^/ops-api/OPSWebServicesUrbAPI/(.*)$ /OPSWebServicesUrbAPI/$1 break;
    proxy_pass __OPS_BACKEND_URL__;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location / {
    rewrite ^/ui(.*)$ /$1 break;
    try_files $uri $uri/ /index.html;
    proxy_buffering on;
    proxy_buffers 16 16k;
    proxy_buffer_size 16k;
  }

  location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2)$ {
    try_files $uri =404;
  }
}
